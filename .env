# RGP_RENEW_PERIOD_MINUTES=7200
# RGP_TRANSFER_PERIOD_MINUTES=7200
# RGP_AUTO_RENEW_PERIOD_MINUTES=64800
# RGP_EXPIRY_GRACE_MINUTES=43200
# RGP_REDEMPTION_PERIOD_MINUTES=43200
# RGP_PENDING_RESTORE_MINUTES=10080
# RGP_PENDING_DELETE_MINUTES=7200
# CRON_WRITE_ZONE="* * * * *"
# CRON_CHANGE_DOMAIN_STATUS="* * * * *"
# CRON_AUTO_APPROVE_TRANSFER="* * * * *"
