#----------> Crontab Configuration for EPP Server <--------------------------------#
# Template: the <CRON_*> schedules are filled in by the cron container at start.
# Job output goes to the container's stdout (docker compose logs epp-cron).

MAILTO=""

# run write-zone.pl
<CRON_WRITE_ZONE>	root	/var/www/cgi-bin/epp/cron/write-zone.pl >> /proc/1/fd/1 2>&1

# run change-domain-status.pl
<CRON_CHANGE_DOMAIN_STATUS>	root	/var/www/cgi-bin/epp/cron/change-domain-status.pl >> /proc/1/fd/1 2>&1

# run auto-approve-transfer.pl
<CRON_AUTO_APPROVE_TRANSFER>	root	/var/www/cgi-bin/epp/cron/auto-approve-transfer.pl >> /proc/1/fd/1 2>&1

# run auto-clean-unused-contact-and-host.pl
<CRON_AUTO_CLEAN>	root	/var/www/cgi-bin/epp/cron/auto-clean-unused-contact-and-host.pl >> /proc/1/fd/1 2>&1

# run clean-epp-sessions.pl
<CRON_CLEAN_SESSIONS>	root	/var/www/cgi-bin/epp/cron/clean-epp-sessions.pl >> /proc/1/fd/1 2>&1

# Upstream also ships these; they are not enabled here:
#59 * * * *	root	/var/www/cgi-bin/epp/cron/statistics.pl >> /proc/1/fd/1 2>&1
#59 * * * *	root	/usr/local/registry/registry_db_backup.pl >> /proc/1/fd/1 2>&1
#1 0 1 * *	root	/var/www/cgi-bin/epp/cron/send-invoice.pl >> /proc/1/fd/1 2>&1

#----------> End Crontab Configuration for EPP Server <----------------------------#
